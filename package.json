{
  "name": "delta-console",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "description": "Delta Console — web control panel plugin for a modular personal-data & automation ecosystem",
  "scripts": {
    "dev": "vite",
    "dev:http": "vite --mode http",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx tests/run.ts",
    "start": "node --env-file-if-exists=.env server/main.mjs",
    "test:server": "node --test tests/*.test.mjs",
    "test:i18n": "node scripts/check-i18n.cjs && node scripts/check-locales.cjs",
    "test:e2e": "node tests/e2e-live.mjs",
    "test:browser": "node scripts/smoke-browser.cjs",
    "test:first-login": "node scripts/first-login.cjs",
    "test:onboarding": "node tests/onboarding-live.mjs",
    "test:key-browser": "node scripts/key-login-browser.cjs",
    "test:notice-browser": "node scripts/notice-browser.cjs",
    "test:chart-browser": "node scripts/chart-browser.cjs",
    "test:regression-ui": "node scripts/regression-ui.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.14",
    "@fontsource/ibm-plex-sans": "^5.0.21",
    "@noble/curves": "^1.8.2",
    "@noble/hashes": "^1.7.2",
    "@scure/base": "^1.2.4",
    "@scure/bip39": "^1.5.4",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "1.4.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.4"
  },
  "license": "Apache-2.0"
}
