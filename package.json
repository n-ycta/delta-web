{
  "name": "delta-console",
  "private": true,
  "version": "0.6.11",
  "type": "module",
  "description": "Delta Console \u2014 web control panel plugin for a modular personal-data & automation ecosystem",
  "scripts": {
    "dev": "vite",
    "dev:http": "vite --mode http",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx --tsconfig node_modules/@delta/ui/tsconfig.json node_modules/@delta/ui/tests/run.ts",
    "start": "node --env-file-if-exists=.env server/main.mjs",
    "test:server": "node --test tests/*.test.mjs",
    "test:i18n": "node node_modules/@delta/ui/scripts/check-i18n.cjs && node node_modules/@delta/ui/scripts/check-locales.cjs",
    "test:e2e": "node tests/e2e-live.mjs",
    "test:browser": "node scripts/smoke-browser.cjs",
    "test:first-login": "node scripts/first-login.cjs",
    "test:onboarding": "node tests/onboarding-live.mjs",
    "test:key-browser": "node scripts/key-login-browser.cjs",
    "test:notice-browser": "node scripts/notice-browser.cjs",
    "test:chart-browser": "node scripts/chart-browser.cjs",
    "test:regression-ui": "node scripts/regression-ui.cjs",
    "test:sidebar-browser": "node scripts/sidebar-browser.cjs",
    "test:input-access-browser": "node scripts/input-access-browser.cjs",
    "test:editor-browser": "node scripts/editor-layout-browser.cjs",
    "test:plugin-notice-browser": "node scripts/plugin-notice-browser.cjs",
    "test:ssh": "node tests/ssh-onboarding-live.mjs",
    "test:ssh-browser": "node scripts/ssh-wizard-browser.cjs",
    "test:session-restart": "node tests/session-restart-live.mjs",
    "test:auth": "node tests/auth-gate-live.mjs",
    "test:recovery": "node tests/recovery-live.mjs"
  },
  "dependencies": {
    "@delta/ui": "https://github.com/n-ycta/delta-ui/archive/55a6ea27ac4177e1b9350ab69afa5db8e4f821f6.tar.gz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@noble/curves": "^1.8.2",
    "@noble/hashes": "^1.7.2",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "delta-mcp": "https://github.com/n-ycta/delta-mcp/archive/21662946a7d627b5121add2ed60ce63b21479ab2.tar.gz",
    "delta-observability": "https://github.com/n-ycta/delta-observability/archive/0a98dd179f286996c096f1336dcd2d0f7e3c2f16.tar.gz",
    "delta-provision": "https://github.com/n-ycta/delta-provision/archive/9c57538faf2f3609e0e8b7f76c61ff3c7bf1c64d.tar.gz",
    "delta-updater": "https://github.com/n-ycta/delta-updater/archive/f79f30ffb4e9ecbb81d58dfd5db35b1c1d737d1a.tar.gz",
    "playwright": "^1.63.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.4"
  },
  "license": "Apache-2.0"
}
